{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid == $userId",
        "Favorites": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId",
          "$targetUserId": {
            ".write": "auth != null && auth.uid == $userId"
          }
        }
      }
    },
    "Bands": {
      ".read": "auth != null",
      "$bandId": {
        ".write": "auth != null && (!data.exists() || data.child('Members_band').child(auth.uid).exists() || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).exists())",
        "Events": {
          "$eventId": {
            "Responses": {
              "$userId": {
                ".write": "auth.uid == $userId && root.child('Bands').child($bandId).child('Events').child($eventId).child('isLocked').val() != true"
              }
            },
            "externalInvitees": {
              "$userId": {
                ".write": "(auth.uid == $userId && root.child('Bands').child($bandId).child('Events').child($eventId).child('isLocked').val() != true) || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Admin'"
              }
            },
            "substituteAssignments": {
              ".read": "auth != null",
              "$slotId": {
                ".write": "auth != null && (root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Admin' || root.child('Bands').child($bandId).child('Events').child($eventId).child('createdBy').val() == auth.uid)"
              }
            }
          }
        }
      }
    },
    "SubRequests": {
      ".indexOn": ["eventId", "EventId", "bandId", "BandId", "Status", "CreatorUserId", "RequestGroupId", "requestGroupId"],
      "$subRequestId": {
        ".read": "auth != null && (data.child('CreatorUserId').val() == auth.uid || data.child('UserId').val() == auth.uid || root.child('subRequestAudience').child($subRequestId).child(auth.uid).val() == true || (data.child('bandId').exists() && (root.child('Bands').child(data.child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.child('BandId').exists() && (root.child('Bands').child(data.child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || data.child('Responses').child(auth.uid).exists())",
        ".write": false,
        "Status": {
          ".write": "auth != null && newData.val() == 'cancelled' && (data.parent().child('CreatorUserId').val() == auth.uid || data.parent().child('UserId').val() == auth.uid || (data.parent().child('bandId').exists() && (root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.parent().child('BandId').exists() && (root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')))"
        },
        "PayAmountMinor": {
          ".write": "auth != null && (data.parent().child('CreatorUserId').val() == auth.uid || data.parent().child('UserId').val() == auth.uid || (data.parent().child('bandId').exists() && (root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.parent().child('BandId').exists() && (root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')))"
        },
        "PayAmount": {
          ".write": "auth != null && (data.parent().child('CreatorUserId').val() == auth.uid || data.parent().child('UserId').val() == auth.uid || (data.parent().child('bandId').exists() && (root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.parent().child('BandId').exists() && (root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')))"
        },
        "Currency": {
          ".write": "auth != null && (data.parent().child('CreatorUserId').val() == auth.uid || data.parent().child('UserId').val() == auth.uid || (data.parent().child('bandId').exists() && (root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.parent().child('BandId').exists() && (root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')))"
        },
        "Description": {
          ".write": "auth != null && (data.parent().child('CreatorUserId').val() == auth.uid || data.parent().child('UserId').val() == auth.uid || (data.parent().child('bandId').exists() && (root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('bandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')) || (data.parent().child('BandId').exists() && (root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child(data.parent().child('BandId').val()).child('Members_band').child(auth.uid).child('Role').val() == 'Admin')))"
        },
        "AssignedUserId": {
          ".write": false
        },
        "AssignedUserName": {
          ".write": false
        },
        "AssignedAt": {
          ".write": false
        },
        "AssignedBy": {
          ".write": false
        },
        "IsSelected": {
          ".write": false
        },
        "SlotId": {
          ".write": false
        },
        "slotId": {
          ".write": false
        },
        "RequestGroupId": {
          ".write": false
        },
        "requestGroupId": {
          ".write": false
        },
        "bandId": {
          ".write": false
        },
        "BandId": {
          ".write": false
        },
        "eventId": {
          ".write": false
        },
        "EventId": {
          ".write": false
        },
        "CreatorUserId": {
          ".write": false
        },
        "UserId": {
          ".write": false
        },
        "PublicationId": {
          ".write": false
        },
        "publicationId": {
          ".write": false
        },
        "NotificationMode": {
          ".write": false
        },
        "notificationMode": {
          ".write": false
        },
        "Responses": {
          "$userId": {
            ".write": "auth != null && auth.uid == $userId && data.parent().parent().child('Status').val() == 'published' && root.child('subRequestAudience').child($subRequestId).child(auth.uid).val() == true"
          }
        }
      }
    },
    "subRequestAudience": {
      ".read": false,
      ".write": false
    },
    "userSubRequestFeed": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "subRequestPublications": {
      ".read": false,
      ".write": false
    },
    "subRequestNotificationAudit": {
      ".read": false,
      ".write": false
    },
    "creatorSubRequestGroups": {
      "$creatorId": {
        ".read": "auth != null && auth.uid == $creatorId",
        ".write": false
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() == true && (data.child('conversationType').val() != 'band_section' || root.child('Bands').child(data.child('bandId').val()).child('Members_band').child(auth.uid).exists())",
        ".write": false
      }
    },
    "userConversations": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "directConversationKeys": {
      ".read": false,
      ".write": false
    },
    "bandSectionConversations": {
      ".read": false,
      ".write": false
    },
    "eventReminderAudit": {
      ".read": "auth != null",
      ".write": false
    },
    "bandconversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "files": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "marketplaceListings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reportedListings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "BandEvents": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "Collabs": {
      "Sessions": {
        ".read": "auth != null",
        "$sessionId": {
          ".write": "auth != null && ( (!data.exists() && newData.child('CreatorId').val() == auth.uid) || (!newData.exists() && data.child('CreatorId').val() == auth.uid) )",
          ".validate": "!newData.exists() || (newData.hasChildren(['CreatorId', 'Title', 'Description', 'SessionType', 'Status']) && (!data.exists() || data.child('CreatorId').val() == newData.child('CreatorId').val()))",
          "Title": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Description": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "SessionType": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "SessionCategory": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "IsDateFlexible": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "StartDateTime": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "EndDateTime": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Location": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Genres": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "RequireResponse": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "RsvpDeadline": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "ReminderIntervalHours": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "UpdatedAt": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Status": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Responses": {
            "$userId": {
              ".write": "auth != null && auth.uid == $userId && root.child('Collabs').child('Applications').child($sessionId).child(auth.uid).child('Status').val() == 'accepted'",
              ".validate": "newData.hasChildren(['status', 'timestamp']) && (newData.child('status').val() == 'YES' || newData.child('status').val() == 'NO' || newData.child('status').val() == 'UNCERTAIN' || newData.child('status').val() == 'attending' || newData.child('status').val() == 'declined' || newData.child('status').val() == 'maybe')"
            }
          }
        }
      },
      "Studios": {
        ".read": "auth != null",
        "$studioId": {
          ".write": "auth != null && (!data.exists() || data.child('CreatorId').val() == auth.uid)",
          ".validate": "newData.hasChildren(['CreatorId', 'Name', 'Description', 'Location']) && (!data.exists() || data.child('CreatorId').val() == newData.child('CreatorId').val())"
        }
      },
      "Applications": {
        "$sessionId": {
          "$applicantId": {
            ".read": "auth != null && (auth.uid == $applicantId || root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val() == auth.uid)",
            ".write": "auth != null && ( (!data.exists() && auth.uid == $applicantId && newData.child('Status').val() == 'pending') || (!newData.exists() && (auth.uid == $applicantId || root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val() == auth.uid)) )",
            ".validate": "!newData.exists() || (newData.hasChildren(['Status', 'CreatorId']) && newData.child('Status').val() == 'pending' && newData.child('CreatorId').val() == root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val())"
          }
        }
      }
    }
  }
}
