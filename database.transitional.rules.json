{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "Bands": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$bandId": {
        "Events": {
          "$eventId": {
            "Responses": {
              "$userId": {
                ".write": "auth.uid == $userId && root.child('Bands').child($bandId).child('Events').child($eventId).child('isLocked').val() != true"
              }
            },
            "externalInvitees": {
              "$userId": {
                ".write": "(auth.uid == $userId && root.child('Bands').child($bandId).child('Events').child($eventId).child('isLocked').val() != true) || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Leader' || root.child('Bands').child($bandId).child('Members_band').child(auth.uid).child('Role').val() == 'Admin'"
              }
            }
          }
        }
      }
    },
    "SubRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userConversations": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "directConversationKeys": {
      ".read": false,
      ".write": false
    },
    "bandSectionConversations": {
      ".read": false,
      ".write": false
    },
    "eventReminderAudit": {
      ".read": "auth != null",
      ".write": false
    },
    "bandconversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "files": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "marketplaceListings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reportedListings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "BandEvents": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "Collabs": {
      "Sessions": {
        ".read": "auth != null",
        "$sessionId": {
          ".write": "auth != null && ( (!data.exists() && newData.child('CreatorId').val() == auth.uid) || (!newData.exists() && data.child('CreatorId').val() == auth.uid) )",
          ".validate": "!newData.exists() || (newData.hasChildren(['CreatorId', 'Title', 'Description', 'SessionType', 'Status']) && (!data.exists() || data.child('CreatorId').val() == newData.child('CreatorId').val()))",
          "Title": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Description": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "SessionType": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "SessionCategory": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "IsDateFlexible": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "StartDateTime": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "EndDateTime": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Location": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Genres": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "RequireResponse": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "RsvpDeadline": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "ReminderIntervalHours": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "UpdatedAt": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Status": {
            ".write": "auth != null && data.parent().child('CreatorId').val() == auth.uid"
          },
          "Responses": {
            "$userId": {
              ".write": "auth != null && auth.uid == $userId && root.child('Collabs').child('Applications').child($sessionId).child(auth.uid).child('Status').val() == 'accepted'",
              ".validate": "newData.hasChildren(['status', 'timestamp']) && (newData.child('status').val() == 'YES' || newData.child('status').val() == 'NO' || newData.child('status').val() == 'UNCERTAIN' || newData.child('status').val() == 'attending' || newData.child('status').val() == 'declined' || newData.child('status').val() == 'maybe')"
            }
          }
        }
      },
      "Studios": {
        ".read": "auth != null",
        "$studioId": {
          ".write": "auth != null && (!data.exists() || data.child('CreatorId').val() == auth.uid)",
          ".validate": "newData.hasChildren(['CreatorId', 'Name', 'Description', 'Location']) && (!data.exists() || data.child('CreatorId').val() == newData.child('CreatorId').val())"
        }
      },
      "Applications": {
        "$sessionId": {
          "$applicantId": {
            ".read": "auth != null && (auth.uid == $applicantId || root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val() == auth.uid)",
            ".write": "auth != null && ( (!data.exists() && auth.uid == $applicantId && newData.child('Status').val() == 'pending') || (!newData.exists() && (auth.uid == $applicantId || root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val() == auth.uid)) )",
            ".validate": "!newData.exists() || (newData.hasChildren(['Status', 'CreatorId']) && newData.child('Status').val() == 'pending' && newData.child('CreatorId').val() == root.child('Collabs').child('Sessions').child($sessionId).child('CreatorId').val())"
          }
        }
      }
    }
  }
}
